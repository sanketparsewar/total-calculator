# Live Bill Scanner Server Configuration
PORT=3001

# Optional: High-accuracy handwriting OCR providers.
# Choose one of the following to activate cloud handwriting neural OCR.
# If none are set, the application automatically uses the built-in Local On-Device OCR.

# 1. Google Cloud Vision OCR (Recommended for handwritten bills & receipts)
# Get a key from Google Cloud Console -> Cloud Vision API
# GOOGLE_VISION_API_KEY=AIzaSy...

# 2. OpenAI GPT-4o-mini Vision
# OPENAI_API_KEY=sk-...

# 3. Azure Computer Vision (Read API)
# AZURE_VISION_KEY=...
# AZURE_VISION_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
